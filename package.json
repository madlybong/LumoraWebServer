{
  "name": "lumora-webserver-workspace",
  "version": "0.1.1",
  "private": true,
  "description": "Monorepo workspace for @astrake/lumora-webserver — Headless PHP 8.2+ Enterprise Website Micro-Kernel, Tailwind CSS v4 Compiler, Zero-Dependency dist/ Bundler, and 12-Gate Compliance Verifier.",
  "author": "Anuvab Chakraborty (https://github.com/madlybong)",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/core",
    "apps/starter"
  ],
  "scripts": {
    "build": "bun run ./tools/build.ts",
    "check": "bun run ./tools/check.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "dev": "bun run ./packages/core/bin/lumora-web.ts dev --cwd ./apps/starter",
    "test": "bun test --jobs=1",
    "cli": "bun run ./packages/core/bin/lumora-web.ts",
    "lumora-web": "bun run ./packages/core/bin/lumora-web.ts",
    "sync:starter": "bun run ./packages/core/bin/lumora-web.ts sync --cwd ./apps/starter",
    "build:starter": "bun run ./packages/core/bin/lumora-web.ts build --cwd ./apps/starter",
    "verify:starter": "bun run ./packages/core/bin/lumora-web.ts verify --cwd ./apps/starter",
    "version:sync": "bun run ./tools/version.ts",
    "version:check": "bun run ./tools/version.ts && git diff --exit-code",
    "changelog": "bun run ./tools/changelog.ts",
    "release:prep": "bun run ./tools/version.ts && bun run ./tools/changelog.ts",
    "validate": "bun run ./tools/validate.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "bun-types": "^1.3.14",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "zod": "^4.0.0"
  }
}
