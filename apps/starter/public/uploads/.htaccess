<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(?i:php[0-9]?|phtml|phar|pl|py|cgi|sh|svg|svgz|html?|xhtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
Options -Indexes -ExecCGI
