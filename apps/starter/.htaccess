# ============================================================================
# @astrake/lumora-webserver — Enterprise Apache / cPanel Hardening & Routing
# ============================================================================

Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct HTTP access to internal directories & runtime vault
    RewriteRule ^(core|storage|templates|content|css|node_modules)(/|$) - [F,L,NC]

    # Block direct access to configuration and lockfiles
    RewriteRule ^(lumora\.config\.php|lumora-lock\.json|package\.json|nginx\.lumora\.conf)$ - [F,L,NC]

    # Allow well-known RFC endpoints (.well-known/security.txt)
    RewriteRule ^\.well-known/ - [L]

    # Block hidden dotfiles
    RewriteRule (^|/)\. - [F,L]

    # Serve existing static assets directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route all other requests through front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By

    <FilesMatch "\.(woff2|svg|png|jpg|jpeg|webp|avif|ico|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
